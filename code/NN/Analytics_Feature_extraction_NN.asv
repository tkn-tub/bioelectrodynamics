%---
%[output:97494f7c]
%   data: {"dataType":"textualVariable","outputData":{"name":"k_DF","value":"2.5773e-05"}}
%---
%[output:2f62441c]
%   data: {"dataType":"textualVariable","outputData":{"name":"SA","value":"31.6228"}}
%---
%[output:3cc7bc3b]
%   data: {"dataType":"textualVariable","outputData":{"name":"k_Dp","value":"2.5773e-05"}}
%---
%[output:5e2632aa]
%   data: {"dataType":"textualVariable","outputData":{"name":"SA","value":"31.6228"}}
%---
%[output:72c9248c]
%   data: {"dataType":"textualVariable","outputData":{"name":"SA_Cp","value":"3.1623"}}
%---
%[output:9835224d]
%   data: {"dataType":"textualVariable","outputData":{"name":"Km_Cp_d","value":"3.1623"}}
%---
%[output:28bb1b76]
%   data: {"dataType":"textualVariable","outputData":{"name":"SA_Cr","value":"31.6228"}}
%---
%[output:41b976bb]
%   data: {"dataType":"textualVariable","outputData":{"name":"SA_Cg","value":"31.6228"}}
